{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": true,
    "incremental": true,
    "paths": {
      "@gif-game/shared/*": ["./packages/shared/src/*"],
      "@gif-game/server/*": ["./packages/server/src/*"],
      "@gif-game/client/*": ["./packages/client/src/*"]
    }
  },
  "references": [
    { "path": "./packages/shared" },
    { "path": "./packages/server" },
    { "path": "./packages/client" }
  ],
  "exclude": ["node_modules", "dist", "*.config.js"]
}
