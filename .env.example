# Discord OAuth2 credentials (required)
# Obtain from https://discord.com/developers/applications
DISCORD_CLIENT_ID=your_discord_client_id_here
DISCORD_CLIENT_SECRET=your_discord_client_secret_here

# Client-side Discord Client ID (required)
# Must match DISCORD_CLIENT_ID above. Prefixed with VITE_ so Vite
# exposes it to the browser bundle via import.meta.env.
VITE_DISCORD_CLIENT_ID=your_discord_client_id_here

# Server port (optional, default: 3001)
PORT=3001
