# =============================================================================
# GIF Guessing Game - Environment Configuration
# Copy this file to .env and fill in your values
# =============================================================================

# -----------------------------------------------------------------------------
# Discord OAuth2 (required)
# Get these from https://discord.com/developers/applications
# -----------------------------------------------------------------------------
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret

# Client-side Discord Client ID (must match DISCORD_CLIENT_ID)
# Prefixed with VITE_ so Vite exposes it to the browser bundle
VITE_DISCORD_CLIENT_ID=your_discord_client_id

# -----------------------------------------------------------------------------
# Server Configuration
# -----------------------------------------------------------------------------
PORT=3001

# -----------------------------------------------------------------------------
# KLIPY GIF API (optional in dev mode)
# Get your API key from https://partner.klipy.com/api-keys
# -----------------------------------------------------------------------------
KLIPY_API_KEY=your_klipy_api_key

# Set to "true" to use mock GIFs instead of calling the real KLIPY API.
# Useful during development to avoid the 100 calls/hour rate limit.
# If KLIPY_API_KEY is not set, dev mode is enabled automatically.
KLIPY_DEV_MODE=true

# -----------------------------------------------------------------------------
# Development / Testing
# -----------------------------------------------------------------------------
# Set to "true" to enable CPU players for solo testing.
# When enabled, if you start a game with fewer than 2 players, 
# CPU players will be added automatically.
CPU_PLAYERS=true
