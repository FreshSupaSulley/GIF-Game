{
  "name": "@gif-game/server",
  "version": "1.0.0",
  "private": true,
  "description": "Node.js/TypeScript game server for the GIF guessing game",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc --build",
    "clean": "rm -rf dist *.tsbuildinfo",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "vitest --run"
  },
  "dependencies": {
    "@gif-game/shared": "*",
    "cors": "^2.8.6",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "vitest": "^4.1.10"
  }
}
